{
  "compilerOptions": {
    "target": "ES2020", // Target modern JavaScript features
    "module": "NodeNext", // Use Node's modern ESM-compatible module system
    "outDir": "./dist", // Output directory for compiled JavaScript
    // "rootDir": "./src", // Remove rootDir to allow compiling multiple top-level dirs (src, api)
    "strict": true, // Enable all strict type-checking options
    "esModuleInterop": true, // Allows default imports from CommonJS modules
    "skipLibCheck": true, // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true, // Disallow inconsistently-cased references
    "resolveJsonModule": true, // Allow importing JSON files
    "moduleResolution": "NodeNext" // Use matching module resolution strategy
  },
  "include": ["src/**/*", "api/**/*"], // Include both src and api directories
  "exclude": ["node_modules", "**/*.spec.ts", "dist"] // Exclude node_modules, tests, and output dir
}
